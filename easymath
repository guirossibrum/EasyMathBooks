#!/usr/bin/env bash
# Local helper: copy this checkout into the Omarchy plugins folder and open it.
# Published install is: omarchy plugin add <repo> --enable
set -euo pipefail
ROOT="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
PLUGIN="$HOME/.config/omarchy/plugins/grbrum.easymath"

mkdir -p "$PLUGIN/bin"
cp -f "$ROOT/manifest.json" "$PLUGIN/manifest.json"
cp -f "$ROOT/Panel.qml" "$PLUGIN/Panel.qml"
cp -f "$ROOT/AppDropdown.qml" "$PLUGIN/AppDropdown.qml"
cp -f "$ROOT/AppSearchableDropdown.qml" "$PLUGIN/AppSearchableDropdown.qml"
cp -f "$ROOT/bin/easymath-cli" "$PLUGIN/bin/easymath-cli"
chmod +x "$PLUGIN/bin/easymath-cli"
# Python sources the CLI imports
cp -f "$ROOT/cli.py" "$ROOT/generate.py" "$ROOT/store.py" "$ROOT/requirements.txt" "$PLUGIN/"

omarchy plugin validate "$PLUGIN"
omarchy plugin enable grbrum.easymath --section right || true
omarchy-shell shell rescanPlugins >/dev/null 2>&1 || true
sleep 0.3
omarchy-shell -q grbrum.easymath toggle || omarchy-shell -q grbrum.easymath open || true
