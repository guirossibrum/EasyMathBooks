#!/usr/bin/env bash
set -euo pipefail
umask 077
# Omarchy watches this directory recursively: bytecode writes can reload the widget.
export PYTHONDONTWRITEBYTECODE=1
ROOT="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
# Omarchy's system Python exposes its packaged Cairo/Pango/GTK bindings.
# No virtual environment, downloads, or package-manager commands are needed.
exec /usr/bin/python3 -B "$ROOT/cli.py" "$@"
